# --- Database ---
DATABASE_URL="postgresql://toolhub:toolhub@localhost:5432/toolhub?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins for the API
CORS_ORIGINS="http://localhost:5173"
# Public site origin, used for canonical URLs, sitemap.xml and OpenGraph tags
PUBLIC_SITE_URL="http://localhost:5173"

# --- Auth ---
# 32+ random chars. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET="change-me-in-production-please-use-a-long-random-value"
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Set to 1 when serving over HTTPS so auth cookies get the Secure flag
COOKIE_SECURE=0

# --- Seed admin (only used by prisma/seed.js) ---
SEED_ADMIN_EMAIL="admin@toolhub.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Cloudflare ---
# Set to 1 only when the origin sits behind Cloudflare: it makes the server
# read the visitor address from CF-Connecting-IP for rate limits and analytics.
TRUST_CLOUDFLARE=0
# Turnstile keys from the Cloudflare dashboard. Leave both empty to switch the
# bot check off entirely.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Which forms the challenge guards (1 = on, 0 = off). Ignored without keys.
TURNSTILE_PROTECT_REVIEWS=1
TURNSTILE_PROTECT_LOGIN=1

# --- Product files ---
# Where uploaded installers live. Relative paths resolve from the project root.
# Keep this outside the repository on a server, e.g. /var/lib/toolhub/products
PRODUCTS_DIR=server/products
# Largest installer the admin panel accepts, in megabytes
PRODUCT_FILE_MAX_MB=512

# --- Storage ---
# "local" writes to server/uploads, "s3" targets any S3-compatible bucket (Cloudflare R2, Supabase, MinIO)
STORAGE_DRIVER=local
# Where the local driver stores images. Relative paths resolve from the project
# root. On a server put it next to the product files, e.g. /var/lib/toolhub/uploads
UPLOADS_DIR=server/uploads
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL images are served from (CDN domain for R2 / public bucket URL)
S3_PUBLIC_URL=""
# Max upload size in megabytes
UPLOAD_MAX_MB=8
