# --- Database ---
DATABASE_URL="postgresql://toolhub:toolhub@localhost:5432/toolhub?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins for the API
CORS_ORIGINS="http://localhost:5173"
# Public site origin, used for canonical URLs, sitemap.xml and OpenGraph tags
PUBLIC_SITE_URL="http://localhost:5173"

# --- Auth ---
# 32+ random chars. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET="change-me-in-production-please-use-a-long-random-value"
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Set to 1 when serving over HTTPS so auth cookies get the Secure flag
COOKIE_SECURE=0

# --- Seed admin (only used by prisma/seed.js) ---
SEED_ADMIN_EMAIL="admin@toolhub.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Storage ---
# "local" writes to server/uploads, "s3" targets any S3-compatible bucket (Cloudflare R2, Supabase, MinIO)
STORAGE_DRIVER=local
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL images are served from (CDN domain for R2 / public bucket URL)
S3_PUBLIC_URL=""
# Max upload size in megabytes
UPLOAD_MAX_MB=8
